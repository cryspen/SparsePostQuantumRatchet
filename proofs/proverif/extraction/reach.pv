(* SPQR extracted model — reachability queries.
   Run: proverif -lib primitives.pvl -lib handwritten_lib.pvl \
                 -lib lib.pvl -lib model.pvl reach.pv
   Expect "false" for every `not event(...)` (each event IS reachable). *)

(* Saturation control (sound: nounif only guides ProVerif's resolution order,
   never the verdict). Same set as conf.pv / auth.pv — deprioritize the attacker
   *building* symbolic ML-KEM ciphertexts / authenticator / MAC terms, the
   resolution blow-up that otherwise dominates at higher NEPOCHS. *)
nounif spqr_r: bitstring, hdr: bitstring, ss: bitstring;
    attacker(pkenc1(spqr_r, hdr, ss)) / 30000.
nounif spqr_r: bitstring, ek: bitstring;
    attacker(pkenc2(spqr_r, ek)) / 30000.
nounif dk: bitstring; attacker(dk2enckey(dk)) / 30000.
nounif dk: bitstring; attacker(dk2seed(dk)) / 30000.
nounif a: bitstring, e: bitstring, k: bitstring; attacker(auth_update(a, e, k)) / 30000.
nounif rk: bitstring, e: bitstring; attacker(auth_new(rk, e)) / 30000.
nounif a: bitstring, e: bitstring, ct: bitstring; attacker(mac_ct_f(a, e, ct)) / 30000.
nounif a: bitstring, e: bitstring, h: bitstring; attacker(mac_hdr_f(a, e, h)) / 30000.
nounif ss: bitstring, e: bitstring; attacker(extern__derive_scka_secret(ss, e)) / 30000.

(* Epoch 1 (always meaningful). *)
query s: bitstring, hd: bitstring;
    event(StartedA(A, B, 1, hd));
    event(CompletedB(B, A, 1, s));
    event(CompletedA(A, B, 1, s)).

(* Epoch 2 — the role swap: at NEPOCHS=1 these are (correctly) UNREACHABLE
   (`not event(...) is true`); they become reachable at `epochs=2`. *)
query s: bitstring;
    event(CompletedB(A, B, 2, s));
    event(CompletedA(B, A, 2, s)).

(* Key agreement is reachable: both roles derive the same epoch secret. *)
query s: bitstring;
    event(CompletedA(A, B, 1, s)) && event(CompletedB(B, A, 1, s)).

process System()
