(* SPQR extracted model — mutual authentication. Run (from the repo root):
     python3 hax.py verify-proverif epochs=N auth.pv
   Expect "true": a completed session implies the peer started it at the same
   epoch, unless an authenticator key (at some epoch ep_ <= ep) was
   compromised. *)

(* Saturation control (sound: nounif only guides ProVerif's resolution order,
   never the verdict). Same set as conf.pv — deprioritize the attacker *building*
   symbolic ML-KEM ciphertexts / authenticator / MAC terms, which is the
   resolution blow-up that makes authentication slow at higher NEPOCHS. *)
nounif spqr_r: bitstring, hdr: bitstring, ss: bitstring;
    attacker(pkenc1(spqr_r, hdr, ss)) / 30000.
nounif spqr_r: bitstring, ek: bitstring;
    attacker(pkenc2(spqr_r, ek)) / 30000.
nounif dk: bitstring; attacker(dk2enckey(dk)) / 30000.
nounif dk: bitstring; attacker(dk2seed(dk)) / 30000.
nounif a: bitstring, e: bitstring, k: bitstring; attacker(auth_update(a, e, k)) / 30000.
nounif rk: bitstring, e: bitstring; attacker(auth_new(rk, e)) / 30000.
nounif a: bitstring, e: bitstring, ct: bitstring; attacker(mac_ct_f(a, e, ct)) / 30000.
nounif a: bitstring, e: bitstring, h: bitstring; attacker(mac_hdr_f(a, e, h)) / 30000.
nounif ss: bitstring, e: bitstring; attacker(extern__derive_scka_secret(ss, e)) / 30000.

(* B completing implies A started, unless an auth key was compromised. *)
query x: principal, y: principal, ep: nat, ep_: nat, sk: bitstring, hd: bitstring;
    event(CompletedB(y, x, ep, sk)) ==>
        ( event(StartedA(x, y, ep, hd))
        || (ep_ <= ep && (event(CompromisedAuthA(x, y, ep_)) || event(CompromisedAuthA(y, x, ep_))
            || event(CompromisedAuthB(y, x, ep_)) || event(CompromisedAuthB(x, y, ep_)))) ).

(* A completing implies B started, unless an auth key was compromised. *)
query x: principal, y: principal, ep: nat, ep_: nat, sk: bitstring, hd: bitstring;
    event(CompletedA(x, y, ep, sk)) ==>
        ( event(StartedB(y, x, ep, hd))
        || (ep_ <= ep && (event(CompromisedAuthA(x, y, ep_)) || event(CompromisedAuthA(y, x, ep_))
            || event(CompromisedAuthB(y, x, ep_)) || event(CompromisedAuthB(x, y, ep_)))) ).

process System()

(* EXPECTPV
RESULT event(CompletedB(y,x_23,ep_9,sk)) ==> event(StartedA(x_23,y,ep_9,hd)) || (ep_9 ≥ ep_ && (event(CompromisedAuthA(x_23,y,ep_)) || event(CompromisedAuthA(y,x_23,ep_)) || event(CompromisedAuthB(y,x_23,ep_)) || event(CompromisedAuthB(x_23,y,ep_)))) is true.
RESULT event(CompletedA(x_23,y,ep_9,sk)) ==> event(StartedB(y,x_23,ep_9,hd)) || (ep_9 ≥ ep_ && (event(CompromisedAuthA(x_23,y,ep_)) || event(CompromisedAuthA(y,x_23,ep_)) || event(CompromisedAuthB(y,x_23,ep_)) || event(CompromisedAuthB(x_23,y,ep_)))) is true.
END *)
