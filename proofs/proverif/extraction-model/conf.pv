(* SPQR extracted model — confidentiality (forward secrecy + post-compromise
   security). Run (from the repo root):
     python3 hax.py verify-proverif epochs=N conf.pv
   Expect "true": if the attacker learns an epoch secret, then either the
   ML-KEM keys at that epoch were compromised, or an authenticator key at some
   epoch ep_ <= ep was compromised before the secret was derived (j < i).
   The ep_ <= ep bound encodes forward secrecy (later compromise does not help).
   Post-compromise security is tested by model.pvl's phase-1 block, which leaks
   the root authenticator key and any attacker-chosen authenticator AFTER every
   epoch has completed: those leaks have j > i, so the j < i guard stops them
   from excusing a past secret. The goal is reported as attacker_p1 (final-phase
   attacker knowledge), matching ../handwritten/spqr-cka.pv. *)

(* Saturation control (sound: nounif only guides ProVerif's resolution order,
   never the verdict). Deprioritize the attacker *building* symbolic ML-KEM
   ciphertexts/keys, which is the decryption-oracle blow-up at NEPOCHS>=2.
   Same idea as the pqxdh model's `nounif ... attacker(smul(z,G)) / 30000`. *)
nounif spqr_r: bitstring, hdr: bitstring, ss: bitstring;
    attacker(pkenc1(spqr_r, hdr, ss)) / 30000.
nounif spqr_r: bitstring, ek: bitstring;
    attacker(pkenc2(spqr_r, ek)) / 30000.
nounif dk: bitstring; attacker(dk2enckey(dk)) / 30000.
nounif dk: bitstring; attacker(dk2seed(dk)) / 30000.
(* ... and the authenticator / MAC / derived-secret terms (the other blow-up
   sources that surface once the KEM ones are tamed). *)
nounif a: bitstring, e: bitstring, k: bitstring; attacker(auth_update(a, e, k)) / 30000.
nounif rk: bitstring, e: bitstring; attacker(auth_new(rk, e)) / 30000.
nounif a: bitstring, e: bitstring, ct: bitstring; attacker(mac_ct_f(a, e, ct)) / 30000.
nounif a: bitstring, e: bitstring, h: bitstring; attacker(mac_hdr_f(a, e, h)) / 30000.
nounif ss: bitstring, e: bitstring; attacker(extern__derive_scka_secret(ss, e)) / 30000.

(* NOTE: an epoch-bound `restriction` (event(...) ==> ep <= NEPOCHS) was tried
   here. It is a *trust assumption* (it removes traces), so it would have to be
   justified separately — and it did not even unblock the proof (saturation
   still stalled). The sound way to bound epochs is a *proven* lemma (which
   costs the same hard stateful reasoning), so it is not kept. Only `nounif`
   above is retained: it is always sound (it only guides resolution order). *)

(* EXPECT: true  (confidentiality with FS + PCS holds for the requestor) *)
query i: time, j: time, x: principal, y: principal, ep: nat, ep_: nat, sk: bitstring;
    event(CompletedA(x, y, ep, sk))@i && attacker(sk) ==>
        ( event(CompromisedKeysA(x, y, ep))
        || event(CompromisedKeysB(y, x, ep))
        || (ep_ <= ep && event(CompromisedAuthA(x, y, ep_))@j && j < i)
        || (ep_ <= ep && event(CompromisedAuthA(y, x, ep_))@j && j < i)
        || (ep_ <= ep && event(CompromisedAuthB(x, y, ep_))@j && j < i)
        || (ep_ <= ep && event(CompromisedAuthB(y, x, ep_))@j && j < i) ).

(* EXPECT: true  (confidentiality with FS + PCS holds for the responder) *)
query i: time, j: time, x: principal, y: principal, ep: nat, ep_: nat, sk: bitstring;
    event(CompletedB(x, y, ep, sk))@i && attacker(sk) ==>
        ( event(CompromisedKeysB(x, y, ep))
        || event(CompromisedKeysA(y, x, ep))
        || (ep_ <= ep && event(CompromisedAuthA(x, y, ep_))@j && j < i)
        || (ep_ <= ep && event(CompromisedAuthA(y, x, ep_))@j && j < i)
        || (ep_ <= ep && event(CompromisedAuthB(x, y, ep_))@j && j < i)
        || (ep_ <= ep && event(CompromisedAuthB(y, x, ep_))@j && j < i) ).

process System()
